# ==========================================
# NEXORA COMMERCE ENVIRONMENT CONFIGURATION
# ==========================================

# Server
NODE_ENV=development
PORT=4000

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://nexora_user:nexora_password@localhost:5432/nexora?schema=public

# Better Auth
BETTER_AUTH_SECRET=replace_with_32_character_minimum_random_secret_string
BETTER_AUTH_URL=http://localhost:4000

# Client App URLs for CORS and Redirection
STORE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Razorpay Standard Checkout (Test Mode Credentials)
RAZORPAY_KEY_ID=rzp_test_sampleKey123
RAZORPAY_KEY_SECRET=sample_secret_never_expose_to_client
RAZORPAY_WEBHOOK_SECRET=sample_webhook_secret

# AI Shopping Assistant
AI_PROVIDER_API_KEY=sample_ai_provider_key
AI_MODEL=gemini-1.5-flash
