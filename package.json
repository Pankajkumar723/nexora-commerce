{
  "name": "nexora-commerce",
  "private": true,
  "version": "1.0.0",
  "description": "Nexora Commerce - AI-Powered Full-Stack E-Commerce Platform",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "turbo run build",
    "build:api": "pnpm --filter @nexora/api prisma:generate && pnpm --filter @nexora/api build",
    "build:storefront": "pnpm --filter @nexora/storefront build",
    "build:admin": "pnpm --filter @nexora/admin build",
    "build:seller": "pnpm --filter @nexora/seller build",
    "start:api": "pnpm --filter @nexora/api start:prod",
    "db:setup": "pnpm --filter @nexora/api db:setup",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "prettier": "^3.5.2",
    "turbo": "^2.4.4"
  },
  "engines": {
    "node": ">=20.0.0 <=22.x"
  }
}
